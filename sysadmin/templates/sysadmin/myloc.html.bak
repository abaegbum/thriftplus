





{% extends 'sysadmin/setup_base.html' %}
{% block content %}


<div style="text-align:center">Back Office Set up</div>

   <table style="margin-top:0%;margin-bottom:01%" width="100%" class="table  table-bordered" id="dataTables-example">

    <tr style="text-align:center;">
         <td ><a href="/sysadmin/sysadmin/setup/password/" style="color:red">Password</a></td>

         <td style="background:blue"><a href="/sysadmin/sysadmin/setup/locations/" style="color:white">Locations</a></td>

         <td ><a href="/sysadmin/sysadmin/setup/products/" style="color:red">Products</a></td>

         <td ><a href="/sysadmin/sysadmin/setup/carding/" style="color:red">Carding</a></td>

    </tr>
</table>

<div style = 'text-align:center'>{{msg}}</div>
 <form action="" method="POST"  onsubmit="disable(this)" enctype="multipart/form-data" >
    {% csrf_token %}
    <section class="content">
      <div class="container-fluid">

            <!-- general form elements -->
            <div class="card card-primary">

                <div class="card-body">
                  <div class="form-group">
                    <!-- <label for="acno">Wallete Address</label> -->
                    <input type="text" id='id_loc' autofocus name="loc" class="form-control" placeholder="Enter a Location here" required>
                  </div>

                </div>
              </div>
            </div>
                <!-- /.card-body -->
           <div class="card-footer">
            <td >
              <input class="btn btn-lg btn-success btn-block" name="submit" type= "submit" value="Save">
            </td>
          </div>
      </section>
   </form>




{% if history %}

<table style="margin-top:01%;margin-bottom:2%;text-align:center;font-size:0.8em" width="100%" class="table  table-bordered" id="dataTables-example">
<tr style="font-weight:bold">
        <td>S/N</td>
        <td>Locations</td>
</tr>

{% for k in history %}

<tr>
    <td>{{forloop.counter}}</td>
    <td><a href="#" onclick = 'locdel({{k.code}})' title='delete this ocation'>{{k.location}}</a></td>

</tr>
{% endfor %}
</table>     




{% else %}




<table style="margin-top:01%;margin-bottom:2%;text-align:center;font-size:0.8em" width="100%" class="table  table-bordered" id="dataTables-example">

   <div style = 'text-align:center'> No entries made   </div>

</table>




{% endif %}



<div id="ind"></div>

 
<script type="text/javascript" language="javascript">
    function locdel(vid){
        
        var state = vid ;
        // alert(state)
        var url = "/sysadmin/sysadmin/popup/location/";
        var i = 0;
        var data='userid='+state;
        $.ajax({
            type:"POST",
            url:url,
            data:data,
            success:function(html) {
                $("#ind").html(html);
                getdind();
            }
        });
        return false;
    }

</script>

<script type="text/javascript" language="javascript">
    function getdind(){
        var diaOpts = {
            autoOpen:true,
            // appendTo:"body1",
            // modal:true,
            // position: ["center", "middle"],
            height:'auto',
            width:'auto',
            title:'Touch the box to close' ,
            closeOnEscape:true,
            show: true,
            hide: true,
            bgiframe: true
        };
        $("#ind").dialog(diaOpts);
    }

</script>

    <script language="javascript" type="text/javascript">
        function disable(f)
        {
            var button = f.elements['submit'];
            button.value = 'Processing';
            button.disabled = 'true';
            return true;
        }
    </script>

   <script type="text/javascript" >
        $(document).ready(function() {

            $("#id_loc").focus();
  
        });
    </script>


{% endblock %}